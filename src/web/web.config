<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      Loopia / Microsoft-IIS serves no MIME type for `.webmanifest` and 404s it.
      The install prompt depends on the browser being able to fetch
      /manifest.webmanifest, so without this the app is an ordinary web page no
      matter what the manifest says — which is exactly what shipped in #2.
      `.json` and `.svg` are registered alongside it for the same reason
      (whats-new.json drives the changelog, icon.svg is the app icon); both
      happen to work on this host today, but relying on that is how this class
      of bug comes back.
    -->
    <staticContent>
      <!--
        IIS sends no Cache-Control here — only last-modified/etag — so browsers
        fall back to heuristic caching and hold on to index.html for as long as
        they like. That is not a small problem: a stale index.html asks for the
        stale asset URLs, so ?v= cache-busting cannot rescue it, and the service
        worker cannot either, because its network-first fetch honours the very
        same HTTP cache. Observed in the wild — a browser that had seen the old
        todo app kept rendering it after three correct deploys.

        So: revalidate everything. The service worker is this app's cache layer
        (precached shell, stale-while-revalidate assets), which is the one that
        can actually be invalidated on purpose — CACHE_VERSION is stamped from
        the commit SHA on every deploy. The HTTP heuristic cache only ever
        contributed bugs.
      -->
      <clientCache cacheControlMode="DisableCache" />

      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <!--
        OpenDyslexic is self-hosted (fonts/), because the service worker only
        caches same-origin assets and Google Fonts — a third-party CDN would
        leave that face broken offline, which for the one face somebody chooses
        for readability is the worst one to lose.
        Registered here for exactly the reason .webmanifest is: this host serves
        nothing it has no MIME type for, and a 404 on a font is silent — the
        page simply renders in the fallback and looks like the setting did not
        work.
      -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
