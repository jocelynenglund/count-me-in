# The Given/When/Then harness lives on the private GitHub Packages npm feed.
# The token comes from the environment, never from this file:
#   locally  NODE_AUTH_TOKEN=<NUGET_AUTH_TOKEN from ~/.secrets/github-packages.env> npm ci
#   in CI    NODE_AUTH_TOKEN: ${{ secrets.NUGET_AUTH_TOKEN }}
@jocelynenglund:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
